# Copy to backend/.env and fill in. NEVER commit the real .env.
# (*) = required in production — the server will not start without it.

# NODE_ENV is set for you: `pnpm dev` = development, `pnpm start` = production
PORT=3000

# (*) Database. TiDB Cloud: mysql://USER:PASSWORD@HOST:4000/haricart
#     (SSL turns on automatically for TiDB; set DATABASE_SSL=true for other hosted MySQL)
DATABASE_URL=
# (*) At least 32 random characters. Generate one with:  openssl rand -hex 32
JWT_SECRET=

# Owner login: your mobile number(s), comma separated, e.g. 9876543210
# Log in with OTP using one of these numbers and you become the owner/admin.
OWNER_PHONES=
# Private Owner ID asked for before the owner screens open (choose your own, keep it secret)
OWNER_SECRET_ID=

# Customer SMS OTP — Firebase (recommended). Same value as VITE_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=

# Customer SMS OTP — Twilio Verify (only if you are NOT using Firebase)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_FROM_PHONE=
# Owner gets an SMS for every new order, e.g. +919876543210
OWNER_ALERT_PHONE=

# Shopify storefront (optional)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_API_ACCESS_TOKEN=

# ---- Optional tuning ----
# Test OTP "1234": on in development, OFF in production. Only set true for a private demo.
# OTP_SIMULATION=false
# Max API calls per minute from one IP (default 300)
# API_RATE_LIMIT_PER_MINUTE=300
# Number of proxies in front of the app (default 1). Use 0 if nothing is in front.
# TRUST_PROXY=1
# Where the built website is (default ../frontend/dist)
# FRONTEND_DIST=
