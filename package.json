{
  "name": "apartment-grocery-delivery",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
  "scripts": {
    "dev": "pnpm --parallel --filter haricart-backend --filter haricart-frontend dev",
    "build": "pnpm --filter haricart-frontend build && pnpm --filter haricart-backend build",
    "start": "pnpm --filter haricart-backend start",
    "check": "pnpm --filter haricart-frontend check && pnpm --filter haricart-backend check",
    "test": "pnpm --filter haricart-frontend test && pnpm --filter haricart-backend test",
    "db:push": "pnpm --filter haricart-backend db:push",
    "db:migrate": "pnpm --filter haricart-backend db:migrate",
    "db:setup": "pnpm --filter haricart-backend db:setup",
    "db:seed": "pnpm --filter haricart-backend db:seed",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "pnpm": {
    "overrides": {
      "tailwindcss>nanoid": "3.3.7"
    },
    "patchedDependencies": {
      "wouter@3.7.1": "patches/wouter@3.7.1.patch"
    }
  },
  "engines": {
    "node": ">=20.19"
  }
}
