# Copy to frontend/.env and fill in. NEVER commit the real .env.
# Only VITE_* values go here. They are built INTO the website and anyone can
# read them in the browser, so never put passwords or secret keys here.

# Firebase phone OTP (Firebase console → Project settings → Your apps → Web app)
# Leave empty to use the server OTP instead (Twilio, or test code 1234 in development).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Your live website address, used in share links and QR codes, e.g. https://haricart.in
# Leave empty to share whatever address the app was opened from.
VITE_PUBLIC_SITE_URL=

# Analytics (optional — the script is left out when these are empty)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Dev only: where the backend runs (default http://localhost:3000)
# BACKEND_URL=http://localhost:3000
